rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function myAccess() {
      return get(/databases/$(database)/documents/access/$(request.auth.token.email)).data;
    }

    function ownerUid() {
      return get(/databases/$(database)/documents/meta/owner).data.uid;
    }

    // Todos — shared access is scoped to the one approved category at the
    // rule level. Reads require the doc's categoryId to match; creates
    // require the new doc's categoryId to match; updates require it to
    // match before AND after, so a todo can't be moved into or out of the
    // shared category by a non-owner.
    match /users/{userId}/todos/{todoId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (myAccess().sharedWorkAccess == true
          && userId == ownerUid()
          && resource.data.categoryId == myAccess().sharedWorkCategoryId)
      );
      allow create: if request.auth != null && (
        request.auth.uid == userId ||
        (myAccess().sharedWorkAccess == true
          && userId == ownerUid()
          && request.resource.data.categoryId == myAccess().sharedWorkCategoryId)
      );
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (myAccess().sharedWorkAccess == true
          && userId == ownerUid()
          && resource.data.categoryId == myAccess().sharedWorkCategoryId
          && request.resource.data.categoryId == myAccess().sharedWorkCategoryId)
      );
      allow delete: if request.auth != null && (
        request.auth.uid == userId ||
        (myAccess().sharedWorkAccess == true
          && userId == ownerUid()
          && resource.data.categoryId == myAccess().sharedWorkCategoryId)
      );
    }

    // Categories — shared access can only touch the single approved
    // category doc (its document ID must equal sharedWorkCategoryId).
    match /users/{userId}/categories/{catId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == userId ||
        (myAccess().sharedWorkAccess == true
          && userId == ownerUid()
          && catId == myAccess().sharedWorkCategoryId)
      );
    }

    // Workbench projects — shared reads limited to projects tagged with
    // the approved category. Untagged projects (categoryId null) never
    // match, so they stay owner-only. Writes stay with the owner.
    match /users/{userId}/workbench/{projectId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (myAccess().sharedWorkAccess == true
          && userId == ownerUid()
          && resource.data.categoryId == myAccess().sharedWorkCategoryId)
      );
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Milestones — a milestone has no categoryId of its own, so the rule
    // looks up the parent project's categoryId with get(). Shared access
    // may flip `done` and nothing else; creating and deleting stay
    // owner-only.
    match /users/{userId}/workbench/{projectId}/milestones/{milestoneId} {
      function projectCategoryId() {
        return get(/databases/$(database)/documents/users/$(userId)/workbench/$(projectId)).data.categoryId;
      }
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (myAccess().sharedWorkAccess == true
          && userId == ownerUid()
          && projectCategoryId() == myAccess().sharedWorkCategoryId)
      );
      allow create, delete: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (myAccess().sharedWorkAccess == true
          && userId == ownerUid()
          && projectCategoryId() == myAccess().sharedWorkCategoryId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["done"]))
      );
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Private per-person budget (guardians' own separate budget/vault) —
    // only that exact person can ever read or write their own private budget.
    match /personalBudgets/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Shared household budget — visible to the owner, anyone with the
    // "household" role, or a "guardian" whose budgetShared flag is on.
    match /households/{householdId} {
      allow read, write: if request.auth != null && (
        myAccess().role == "owner" ||
        myAccess().role == "household" ||
        (myAccess().role == "guardian" && myAccess().budgetShared == true)
      );
    }

    // Access list — who's allowed into the app and what they're permitted.
    // Anyone signed in can read their own record. Only the owner can add,
    // remove, or change someone's role. The "household" role (Amon) can
    // flip just the budgetShared flag on a guardian's record and nothing
    // else — approving/revoking shared-budget access is their only
    // management power.
    match /access/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && myAccess().role == "owner";
      allow update: if request.auth != null && (
        myAccess().role == "owner" ||
        (myAccess().role == "household"
          && resource.data.role == "guardian"
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && request.resource.data.sharedWorkAccess == resource.data.sharedWorkAccess) ||
        (docId == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["uid"]))
      );
      allow delete: if request.auth != null && myAccess().role == "owner";
    }

    // Each person's own Telegram bot token + chat ID for personal
    // notifications (e.g. shared budget access requests). Deliberately
    // separate from the widely-readable `access` collection — a bot token
    // is a credential, so only its owner can ever read or write it. The
    // Cloudflare Worker reads across everyone's docs via its Admin token,
    // independent of this rule.
    match /notifyConfig/{email} {
      allow read, write: if request.auth != null && request.auth.token.email == email;
    }

    // Owner-adjustable default window for how long a shared budget access
    // request waits before auto-granting if nobody denies it.
    match /meta/budgetAccessWindow {
      allow read: if request.auth != null;
      allow write: if request.auth != null && myAccess().role == "owner";
    }

    // Guardians' "Request shared budget access" flow — an alternate path
    // to the same `budgetShared` flag the owner/household can already
    // toggle by hand. The Cloudflare Worker acts with a Google
    // service-account token against the Firestore REST API, authorized by
    // project IAM rather than these rules, so it can still write
    // notification bookkeeping and flip `budgetShared` on auto-grant
    // regardless of what's allowed below — these rules only govern the two
    // web clients (the requester, and owner/household reviewing/denying).
    match /budgetAccessRequests/{requestId} {
      allow read: if request.auth != null && (
        resource.data.requesterEmail == request.auth.token.email ||
        myAccess().role == "owner" ||
        myAccess().role == "household"
      );
      allow create: if request.auth != null &&
        myAccess().role == "guardian" &&
        request.resource.data.requesterEmail == request.auth.token.email &&
        request.resource.data.status == "pending";
      allow update: if request.auth != null &&
        (myAccess().role == "owner" || myAccess().role == "household") &&
        resource.data.status == "pending" &&
        request.resource.data.status == "denied" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "decidedBy", "decidedAction", "decidedAt"]);
      allow delete: if false;
    }
  }
}