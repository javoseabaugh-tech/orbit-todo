# Staging Orbit: a separate Firebase project with its own data, rules and
# sign-in, used to test the redesign without touching live users.
# Used by `npm run build:staging` and the staging deploy. Fill the REPLACE_ME
# values in from STAGING.md step 2; the deploy refuses to run until you do.
VITE_APP_ENV=staging
VITE_FIREBASE_API_KEY=REPLACE_ME
VITE_FIREBASE_AUTH_DOMAIN=orbit-staging-49988.web.app
VITE_FIREBASE_PROJECT_ID=orbit-staging-49988
VITE_FIREBASE_STORAGE_BUCKET=orbit-staging-49988.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=2531876823
VITE_FIREBASE_APP_ID=REPLACE_ME
VITE_RECAPTCHA_SITE_KEY=REPLACE_ME
