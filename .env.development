# `npm run dev` points at STAGING, so local tinkering never touches live
# data. Keep this file identical to .env.staging.
VITE_APP_ENV=staging
VITE_FIREBASE_API_KEY=REPLACE_ME
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_ME.web.app
VITE_FIREBASE_PROJECT_ID=REPLACE_ME
VITE_FIREBASE_STORAGE_BUCKET=REPLACE_ME.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME
VITE_FIREBASE_APP_ID=REPLACE_ME
VITE_RECAPTCHA_SITE_KEY=REPLACE_ME
